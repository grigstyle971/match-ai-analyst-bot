# Токен бота от @BotFather
BOT_TOKEN=

# Ключ API языковой модели.
# Бесплатно: Google Gemini — ключ на https://aistudio.google.com/apikey
LLM_API_KEY=

# Адрес OpenAI-совместимого API. Пусто = официальный OpenAI.
# Gemini:     https://generativelanguage.googleapis.com/v1beta/openai/
# OpenRouter: https://openrouter.ai/api/v1
# OmniRoute:  http://localhost:20128/v1
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/

# Модель (Gemini: gemini-3.6-flash; OpenAI: gpt-4o-mini; OmniRoute: auto)
LLM_MODEL=gemini-3.6-flash

# Сколько модель «думает»: none — быстрее всего (ответ ~10–25 с), low/medium/high — дольше.
# Пусто — параметр не передаётся (для API, которые его не поддерживают)
LLM_REASONING_EFFORT=none

# Запасная модель того же провайдера и резервный провайдер (необязательно)
LLM_FALLBACK_MODEL=gemini-3.5-flash
RESERVE_BASE_URL=http://127.0.0.1:20128/v1
RESERVE_API_KEY=omniroute-local
RESERVE_MODEL=cfp/zai-org/glm-5.2

# Резервная статистика: бесплатный ключ с https://www.football-data.org/client/register
FOOTBALL_DATA_TOKEN=

# Mini App: порт локального сервера (0 — выключить). WEBAPP_URL пусто — туннель Cloudflare поднимется сам
WEBAPP_PORT=8088
WEBAPP_URL=

# Необязательные настройки
LLM_TIMEOUT=60
MAX_INPUT_CHARS=6000
COOLDOWN_SECONDS=5
